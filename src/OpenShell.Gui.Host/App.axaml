<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenShell.Gui.Host.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://openshell-gui/Styles/Colors.axaml" />
        <ResourceInclude Source="avares://openshell-gui/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://openshell-gui/Styles/Controls.axaml" />
    <StyleInclude Source="avares://openshell-gui/Styles/ContextMenus.axaml" />
  </Application.Styles>
</Application>
