<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenShell.Gui.Host.Views"
             x:Class="OpenShell.Gui.Host.Views.ToolBar"
             x:CompileBindings="False">
  <StackPanel Orientation="Vertical" Spacing="2" Margin="2">
    <DockPanel>
      <views:BreadcrumbBar DockPanel.Dock="Left"/>
      <TextBox DockPanel.Dock="Right" Width="200" Watermark="gui.search.watermark"
               Text="{Binding SearchText, Mode=TwoWay}" Margin="2,0,0,0"/>
    </DockPanel>
    <StackPanel Orientation="Horizontal" Spacing="2">
      <Button Content="←" ToolTip.Tip="gui.tool.back" Command="{Binding NavigateBackCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
      <Button Content="→" ToolTip.Tip="gui.tool.forward" Command="{Binding NavigateForwardCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
      <Button Content="↑" ToolTip.Tip="gui.tool.up" Command="{Binding NavigateUpCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
      <Button Content="↻" ToolTip.Tip="gui.tool.refresh" Command="{Binding RefreshCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
      <Separator Margin="4,0"/>
      <Button Content="gui.button.new" ToolTip.Tip="gui.tool.newFolder" Command="{Binding NewFolderCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
      <Separator Margin="4,0"/>
      <Button Content="gui.button.copy" ToolTip.Tip="gui.tool.copy" Command="{Binding CopyCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
      <Button Content="gui.button.cut" ToolTip.Tip="gui.tool.cut" Command="{Binding CutCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
      <Button Content="gui.button.paste" ToolTip.Tip="gui.tool.paste" Command="{Binding PasteCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
      <Separator Margin="4,0"/>
      <Button Content="gui.button.move" ToolTip.Tip="gui.tool.move" Command="{Binding MoveCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
      <Button Content="gui.button.rename" ToolTip.Tip="gui.tool.rename" Command="{Binding RenameCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
      <Button Content="gui.button.delete" ToolTip.Tip="gui.tool.delete" Command="{Binding DeleteCommand}"
              Classes="ToolBarButton" Background="Transparent" BorderThickness="0" Padding="8,4" Margin="2"/>
    </StackPanel>
  </StackPanel>
</UserControl>
