<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenShell.Gui.Host.Views"
        xmlns:conv="clr-namespace:OpenShell.Gui.Host.Converters"
        x:Class="OpenShell.Gui.Host.Views.MainWindow"
        x:Name="Root"
        x:CompileBindings="False"
        Title="gui.title"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        Background="{DynamicResource ShellSurfaceBrush}"
        KeyDown="OnWindowKeyDown"
        KeyUp="OnWindowKeyUp"
        Closing="OnWindowClosing"
        Closed="OnWindowClosed">
  <Window.Resources>
    <conv:ConsoleEntryKindToBrushConverter x:Key="ConsoleEntryBrush"/>
  </Window.Resources>
  <DockPanel>
    <Menu x:Name="MainMenu"
          DockPanel.Dock="Top"
          IsVisible="False">
      <!-- MenuVisible binding applied in code-behind when DataContext is set -->
      <MenuItem Header="gui.menu.file" Tag="gui.menu.file">
        <MenuItem Header="gui.menu.openConsole" Command="{Binding ToggleConsoleCommand}" />
        <MenuItem Header="gui.menu.newWindow" Click="OnNewWindowClicked" />
        <Separator />
        <MenuItem Header="gui.menu.newTab" InputGesture="Ctrl+T" Command="{Binding NewTabCommand}" />
        <MenuItem Header="gui.menu.closeTab" InputGesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <Separator />
        <MenuItem Header="gui.menu.exit" InputGesture="Alt+F4" Click="OnExitClicked" />
      </MenuItem>
      <MenuItem Header="gui.menu.edit" Tag="gui.menu.edit">
        <MenuItem Header="gui.ctx.copy" InputGesture="Ctrl+C" Command="{Binding CopyCommand}" Tag="gui.ctx.copy"/>
        <MenuItem Header="gui.ctx.move" InputGesture="Ctrl+M" Command="{Binding MoveCommand}" Tag="gui.ctx.move"/>
        <MenuItem Header="gui.ctx.delete" InputGesture="Delete" Command="{Binding DeleteCommand}" Tag="gui.ctx.delete"/>
        <MenuItem Header="gui.ctx.rename" InputGesture="F2" Command="{Binding RenameCommand}" Tag="gui.ctx.rename"/>
      </MenuItem>
      <MenuItem Header="gui.menu.view" Tag="gui.menu.view">
        <MenuItem Header="gui.menu.theme" Tag="gui.menu.theme">
          <MenuItem Header="gui.theme.light" Tag="gui.theme.light" Click="OnThemeClicked" />
          <MenuItem Header="gui.theme.dark" Tag="gui.theme.dark" Click="OnThemeClicked" />
          <MenuItem Header="gui.theme.system" Tag="gui.theme.system" Click="OnThemeClicked" />
        </MenuItem>
        <MenuItem Header="gui.menu.viewMode" Tag="gui.menu.viewMode">
          <MenuItem Header="gui.viewMode.details" Tag="gui.viewMode.details" Click="OnViewModeClicked" />
          <MenuItem Header="gui.viewMode.icons" Tag="gui.viewMode.icons" Click="OnViewModeClicked" />
          <MenuItem Header="gui.viewMode.tiles" Tag="gui.viewMode.tiles" Click="OnViewModeClicked" />
          <MenuItem Header="gui.viewMode.list" Tag="gui.viewMode.list" Click="OnViewModeClicked" />
        </MenuItem>
        <Separator />
        <MenuItem Header="gui.menu.toggleConsole" Command="{Binding ToggleConsoleCommand}" />
        <MenuItem Header="gui.commandPalette.title" InputGesture="Ctrl+Shift+P" Click="OnCommandPaletteClicked" />
        <MenuItem Header="gui.menu.detailsPane" Click="OnToggleDetailsPane" />
        <MenuItem Header="gui.menu.previewPane" Click="OnTogglePreviewPane" />
      </MenuItem>
      <MenuItem Header="gui.menu.help" Tag="gui.menu.help">
        <MenuItem Header="gui.menu.about" InputGesture="F1" Click="OnAboutClicked" />
      </MenuItem>
    </Menu>

    <views:ToolBar DockPanel.Dock="Top" x:Name="ToolBarControl"/>

    <Border DockPanel.Dock="Top" x:Name="TabStripBorder" Classes="TabStrip" Padding="6,3">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TabStripItems" ItemsSource="{Binding Tabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto">
                  <Button Grid.Column="0" Content="{Binding Title}" ToolTip.Tip="{Binding Title}"
                          Classes="TabButton" Classes.ActiveTab="{Binding IsActive}"
                          Click="OnTabButtonClick" Tag="{Binding}" />
                  <Button Grid.Column="1" ToolTip.Tip="gui.menu.closeTab" AutomationProperties.Name="gui.menu.closeTab"
                          Classes="TabCloseButton" Click="OnTabCloseButtonClick" Tag="{Binding}"
                          Margin="-30,2,2,2" HorizontalAlignment="Right">
                    <Viewbox Width="14" Height="14"><Path Data="{DynamicResource IconClose}" Fill="{DynamicResource ShellTextSecondaryBrush}"/></Viewbox>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Button Grid.Column="1" x:Name="NewTabButton" ToolTip.Tip="gui.menu.newTab" Margin="4,0,0,0"
                AutomationProperties.Name="gui.menu.newTab" Classes="NewTabButton"
                Command="{Binding NewTabCommand}">
          <Viewbox Width="14" Height="14"><Path Data="{DynamicResource IconAdd}" Fill="{DynamicResource ShellTextPrimaryBrush}"/></Viewbox>
        </Button>
      </Grid>
    </Border>

    <views:StatusBar DockPanel.Dock="Bottom" x:Name="StatusBarControl"/>

    <Border DockPanel.Dock="Bottom" x:Name="ErrorPanelBorder" IsVisible="{Binding IsErrorPanelVisible}"
            Background="{DynamicResource ShellDangerSurfaceBrush}" MaxHeight="150">
      <DockPanel>
        <TextBlock Text="gui.errors.title" Foreground="{DynamicResource ShellDangerBrush}" Margin="8,4" DockPanel.Dock="Top"/>
        <ListBox x:Name="ErrorListBox" ItemsSource="{Binding Errors}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Message}" Foreground="{DynamicResource ShellDangerBrush}" Margin="8,2"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" x:Name="ConsolePanelBorder" IsVisible="{Binding IsConsoleVisible}"
            Background="{DynamicResource ShellConsoleSurfaceBrush}" MinHeight="100">
      <DockPanel>
        <GridSplitter DockPanel.Dock="Top" Height="4" HorizontalAlignment="Stretch"
                      Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                      ResizeDirection="Rows"/>
        <TextBlock Text="gui.console.title" Foreground="{DynamicResource ShellTextSecondaryBrush}" Margin="8,4" DockPanel.Dock="Top"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="4,2">
          <TextBlock Text="> " Foreground="{DynamicResource ShellSuccessBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBox Text="{Binding CommandInput}" Watermark="gui.console.input"
                   Background="Transparent" Foreground="{DynamicResource ShellConsoleTextBrush}" BorderThickness="0"
                   x:Name="ConsoleInputBox"/>
        </DockPanel>
        <ListBox x:Name="ConsoleOutputList" ItemsSource="{Binding ConsoleOutputLines}"
                 Background="Transparent" Foreground="{DynamicResource ShellConsoleTextBrush}" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" Foreground="{Binding Kind, Converter={StaticResource ConsoleEntryBrush}}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Grid x:Name="WorkspaceGrid" Background="{DynamicResource ShellContentSurfaceBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" MinWidth="150" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="320" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <views:NavigationPane Grid.Column="0" x:Name="NavPaneControl"/>

      <GridSplitter Grid.Column="1"
                    Width="4"
                    ResizeDirection="Columns"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

      <Grid Grid.Column="2">
        <views:FileListView x:Name="MainFileListView"/>
      </Grid>

      <GridSplitter Grid.Column="3"
                    Width="4"
                    IsVisible="{Binding IsDetailsPaneVisible}"
                    ResizeDirection="Columns"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

      <views:DetailsPane Grid.Column="4"
                         x:Name="DetailsPaneControl"
                         Width="280"
                         IsVisible="{Binding IsDetailsPaneVisible}" />

      <GridSplitter Grid.Column="5"
                    Width="4"
                    IsVisible="{Binding IsPreviewPaneVisible}"
                    ResizeDirection="Columns"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

      <views:PreviewPane Grid.Column="6"
                         x:Name="PreviewPaneControl"
                         IsVisible="{Binding IsPreviewPaneVisible}" />
    </Grid>
  </DockPanel>
</Window>
