<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenShell.Gui.Host</RootNamespace>
    <AssemblyName>openshell-gui</AssemblyName>
    <RollForward>LatestMinor</RollForward>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <BaseOutputPath>$(RepoRoot)artifacts\bin\OpenShell\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <CreateHardLinksForCopyAdditionalFilesIfPossible>true</CreateHardLinksForCopyAdditionalFilesIfPossible>
    <CreateHardLinksForCopyLocalIfPossible>true</CreateHardLinksForCopyLocalIfPossible>
    <CopyRetryCount>10</CopyRetryCount>
    <CopyRetryDelayMilliseconds>50</CopyRetryDelayMilliseconds>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenShell.Core\OpenShell.Core.csproj" />
    <ProjectReference Include="..\OpenShell.Providers.FileSystem\OpenShell.Providers.FileSystem.csproj" />
    <ProjectReference Include="..\OpenShell.Providers.Variables\OpenShell.Providers.Variables.csproj" />
    <ProjectReference Include="..\OpenShell.Cli.Host\OpenShell.Cli.Host.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenShell.Gui.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.ReactiveUI" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
