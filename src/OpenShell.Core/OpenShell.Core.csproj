<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenShell</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>OpenShell.Core</PackageId>
    <Description>OpenShell core abstractions: Items, Providers, Paths, Commands, Bridge.</Description>
    <!-- ADR-0037 §5: WinVerifyTrust P/Invoke 需要 unsafe (WINTRUST_DATA 含指针字段)。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- TOML parser used by ADR-0024 alias/function config and ADR-0022 settings. -->
    <PackageReference Include="Tomlyn" />
    <!-- ADR-0039 §8: Ed25519 签名校验 (BouncyCastle 提供 Ed25519 支持, .NET 8 BCL 不含)。 -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <!-- ADR-0031: 结构化日志抽象 (ILoggerProvider / LogLevel / BeginScope) -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- ADR-0037: Subject/IObservable 用于 UpdateService.StatusChanged 通知 -->
    <PackageReference Include="System.Reactive" />
    <!-- ADR-0031 §5-9: M3+ 可观测性栈 (Serilog 结构化日志 + OpenTelemetry traces/metrics)。 -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <!-- ADR-0030 §8: 长期 SQLite/FTS5 文件索引 (Microsoft.Data.Sqlite 含 FTS5 支持)。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- IH-009: 图片预览解码 (JPEG/GIF/BMP/WEBP → PNG, 纯托管)。 -->
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <!-- ADR-0048 §6.5: Import-Csv 复用 ConvertFromCsvCommand.ParseCsvLine 内部辅助方法，
       通过 InternalsVisibleTo 暴露 internal 成员给测试项目（per ADR-0033 §测试约定）。-->
  <ItemGroup>
    <InternalsVisibleTo Include="OpenShell.Core.Tests" />
  </ItemGroup>

</Project>
